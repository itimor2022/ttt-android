<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈光晕 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#200091EA" />
            <size
                android:width="32dp"
                android:height="32dp" />
        </shape>
    </item>
    <!-- 内圈白边 -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size
                android:width="16dp"
                android:height="16dp" />
        </shape>
    </item>
    <!-- 中心蓝点 -->
    <item
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp"
        android:top="10dp">
        <shape android:shape="oval">
            <solid android:color="#0091EA" />
            <size
                android:width="12dp"
                android:height="12dp" />
        </shape>
    </item>
</layer-list>

