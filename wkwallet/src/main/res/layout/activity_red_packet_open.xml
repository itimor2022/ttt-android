<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AA000000">

    <!-- 红包主体 -->
    <LinearLayout
        android:id="@+id/redPacketLayout"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_red_packet_open_main"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 关闭按钮 -->
        <ImageView
            android:id="@+id/closeBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_close_gold" />

        <!-- 发送者头像 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatarIv"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/roundedCornerImageStyle" />

        <!-- 发送者名字 -->
        <TextView
            android:id="@+id/senderNameTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="发送者"
            android:textColor="#FFD54F"
            android:textSize="16sp" />

        <!-- 祝福语 -->
        <TextView
            android:id="@+id/remarkTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="@string/default_red_packet_remark"
            android:textColor="#FFECB3"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 开按钮 -->
        <FrameLayout
            android:id="@+id/openBtn"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_red_packet_open_btn"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="開"
                android:textColor="#D32F2F"
                android:textSize="32sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- 查看详情按钮 -->
        <TextView
            android:id="@+id/detailBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="@string/red_packet_view_detail"
            android:textColor="#FFCC80"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 红包状态 -->
        <TextView
            android:id="@+id/statusTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFCC80"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 金额显示 (领取后显示) -->
    <LinearLayout
        android:id="@+id/amountLayout"
        android:layout_width="300dp"
        android:layout_height="400dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_red_packet_open_main"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 关闭按钮 -->
        <ImageView
            android:id="@+id/closeBtn2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:src="@drawable/ic_close_gold" />

        <!-- 发送者名字 -->
        <TextView
            android:id="@+id/senderNameTv2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="发送者的红包"
            android:textColor="#FFCC80"
            android:textSize="14sp" />

        <!-- 金额 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/amountTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="#FFD54F"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="元"
                android:textColor="#FFD54F"
                android:textSize="16sp" />

        </LinearLayout>

        <!-- 祝福语 -->
        <TextView
            android:id="@+id/remarkTv2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/default_red_packet_remark"
            android:textColor="#FFECB3"
            android:textSize="15sp" />

        <!-- 查看详情 -->
        <TextView
            android:id="@+id/viewDetailBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_view_detail_btn"
            android:gravity="center"
            android:text="@string/red_packet_view_detail"
            android:textColor="#C62828"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
