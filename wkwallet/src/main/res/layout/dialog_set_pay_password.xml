<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_top_round"
    android:orientation="vertical">

    <!-- 标题栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/closeBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@drawable/ic_close"
            app:tint="@color/color999" />

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="设置支付密码"
            android:textColor="@color/colorDark"
            android:textSize="17sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/colorLine" />

    <!-- 步骤指示器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="20dp">

        <LinearLayout
            android:id="@+id/step1Layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_step_active">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <TextView
                android:id="@+id/step1Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="输入密码"
                android:textColor="@color/colorAccent"
                android:textSize="12sp" />

        </LinearLayout>

        <View
            android:id="@+id/stepLine"
            android:layout_width="60dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="12dp"
            android:background="@color/colorLine" />

        <LinearLayout
            android:id="@+id/step2Layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/step2Circle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_step_inactive">

                <TextView
                    android:id="@+id/step2Number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="2"
                    android:textColor="@color/color999"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <TextView
                android:id="@+id/step2Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="确认密码"
                android:textColor="@color/color999"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 提示文字 -->
    <TextView
        android:id="@+id/hintTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:text="请输入6位数字支付密码"
        android:textColor="@color/colorDark"
        android:textSize="15sp" />

    <!-- 密码输入框 -->
    <LinearLayout
        android:id="@+id/passwordLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp">

        <FrameLayout
            android:id="@+id/box1"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_password_box_dialog">

            <View
                android:id="@+id/dot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_password_dot"
                android:visibility="invisible" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/box2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_password_box_dialog">

            <View
                android:id="@+id/dot2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_password_dot"
                android:visibility="invisible" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/box3"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_password_box_dialog">

            <View
                android:id="@+id/dot3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_password_dot"
                android:visibility="invisible" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/box4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_password_box_dialog">

            <View
                android:id="@+id/dot4"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_password_dot"
                android:visibility="invisible" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/box5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_password_box_dialog">

            <View
                android:id="@+id/dot5"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_password_dot"
                android:visibility="invisible" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/box6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_password_box_dialog">

            <View
                android:id="@+id/dot6"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_password_dot"
                android:visibility="invisible" />

        </FrameLayout>

    </LinearLayout>

    <!-- 错误提示 -->
    <TextView
        android:id="@+id/errorTv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="8dp"
        android:textColor="#F44336"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 安全数字键盘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F5F5F5"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="12dp">

        <!-- 第一行 1 2 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key1"
                style="@style/KeyboardKeyDialogStyle"
                android:text="1" />

            <TextView
                android:id="@+id/key2"
                style="@style/KeyboardKeyDialogStyle"
                android:text="2" />

            <TextView
                android:id="@+id/key3"
                style="@style/KeyboardKeyDialogStyle"
                android:text="3" />

        </LinearLayout>

        <!-- 第二行 4 5 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key4"
                style="@style/KeyboardKeyDialogStyle"
                android:text="4" />

            <TextView
                android:id="@+id/key5"
                style="@style/KeyboardKeyDialogStyle"
                android:text="5" />

            <TextView
                android:id="@+id/key6"
                style="@style/KeyboardKeyDialogStyle"
                android:text="6" />

        </LinearLayout>

        <!-- 第三行 7 8 9 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/key7"
                style="@style/KeyboardKeyDialogStyle"
                android:text="7" />

            <TextView
                android:id="@+id/key8"
                style="@style/KeyboardKeyDialogStyle"
                android:text="8" />

            <TextView
                android:id="@+id/key9"
                style="@style/KeyboardKeyDialogStyle"
                android:text="9" />

        </LinearLayout>

        <!-- 第四行 空 0 删除 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="0.5dp"
                android:layout_weight="1"
                android:background="#E8E8E8" />

            <TextView
                android:id="@+id/key0"
                style="@style/KeyboardKeyDialogStyle"
                android:text="0" />

            <FrameLayout
                android:id="@+id/keyDelete"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="0.5dp"
                android:layout_marginEnd="1dp"
                android:layout_weight="1"
                android:background="@drawable/bg_keyboard_key_dialog">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_keyboard_delete"
                    app:tint="#333333" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

