<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <data>
    </data>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/homeColor">
        
        <!-- 顶部安全区域 + 渐变背景 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 渐变背景 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_wallet_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 状态栏占位 -->
                <View
                    android:id="@+id/statusBarView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp" />

                <!-- 自定义标题栏 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/backIv"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:src="@mipmap/ic_ab_back"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="实名认证"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </RelativeLayout>

            </LinearLayout>

        </FrameLayout>
        
        <!-- 内容区 -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-80dp"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">
                
                <!-- 表单卡片 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    app:cardBackgroundColor="@color/layoutColor"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        
                        <!-- 提示信息 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="为了您的资金安全，使用钱包功能前需要进行实名认证"
                            android:textSize="14sp"
                            android:textColor="@color/color999"
                            android:layout_marginBottom="24dp" />
                        
                        <!-- 真实姓名 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:layout_marginBottom="12dp">
                            
                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="真实姓名"
                                android:textSize="14sp"
                                android:textColor="@color/colorDark" />
                            
                            <EditText
                                android:id="@+id/real_name_et"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="请输入真实姓名"
                                android:textSize="14sp"
                                android:textColor="@color/colorDark"
                                android:background="@null"
                                android:inputType="textPersonName" />
                        </LinearLayout>
                        
                        <!-- 身份证号 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:layout_marginBottom="12dp">
                            
                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="身份证号"
                                android:textSize="14sp"
                                android:textColor="@color/colorDark" />
                            
                            <EditText
                                android:id="@+id/id_card_et"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="请输入身份证号"
                                android:textSize="14sp"
                                android:textColor="@color/colorDark"
                                android:background="@null"
                                android:inputType="text"
                                android:maxLength="18" />
                        </LinearLayout>
                        
                        <!-- 手机号 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:layout_marginBottom="12dp">
                            
                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="手机号"
                                android:textSize="14sp"
                                android:textColor="@color/colorDark" />
                            
                            <TextView
                                android:id="@+id/phone_tv"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="注册手机号"
                                android:textSize="14sp"
                                android:textColor="@color/colorDark"
                                android:gravity="center_vertical" />
                        </LinearLayout>
                        
                        <!-- 验证码 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="12dp"
                            android:layout_marginBottom="32dp">
                            
                            <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:text="验证码"
                                android:textSize="14sp"
                                android:textColor="@color/colorDark" />
                            
                            <EditText
                                android:id="@+id/code_et"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:hint="请输入验证码"
                                android:textSize="14sp"
                                android:textColor="@color/colorDark"
                                android:background="@null"
                                android:inputType="number"
                                android:maxLength="6" />
                            
                            <TextView
                                android:id="@+id/get_code_tv"
                                android:layout_width="100dp"
                                android:layout_height="32dp"
                                android:text="获取验证码"
                                android:textSize="12sp"
                                android:textColor="@color/colorAccent"
                                android:background="#E0E0E0"
                                android:gravity="center"
                                android:layout_marginLeft="12dp" />
                        </LinearLayout>
                        
                        <!-- 提交按钮 -->
                        <Button
                            android:id="@+id/submit_btn"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="提交认证"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:background="@color/colorAccent"
                            android:layout_marginBottom="16dp" />
                        
                        <!-- 隐私提示 -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="我们会对您的个人信息严格保密，仅用于实名认证"
                            android:textSize="12sp"
                            android:textColor="@color/color999"
                            android:gravity="center" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                
                <!-- 底部安全提示 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="24dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_security_shield"
                        app:tint="@color/color999" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="信息安全由银行级加密保护"
                        android:textColor="@color/color999"
                        android:textSize="12sp" />

                </LinearLayout>
                
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>