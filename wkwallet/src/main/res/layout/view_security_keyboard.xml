<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/homeColor"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <!-- 第一行 1 2 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key1"
            style="@style/KeyboardKeyStyle"
            android:text="1" />

        <TextView
            android:id="@+id/key2"
            style="@style/KeyboardKeyStyle"
            android:text="2" />

        <TextView
            android:id="@+id/key3"
            style="@style/KeyboardKeyStyle"
            android:text="3" />

    </LinearLayout>

    <!-- 第二行 4 5 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key4"
            style="@style/KeyboardKeyStyle"
            android:text="4" />

        <TextView
            android:id="@+id/key5"
            style="@style/KeyboardKeyStyle"
            android:text="5" />

        <TextView
            android:id="@+id/key6"
            style="@style/KeyboardKeyStyle"
            android:text="6" />

    </LinearLayout>

    <!-- 第三行 7 8 9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/key7"
            style="@style/KeyboardKeyStyle"
            android:text="7" />

        <TextView
            android:id="@+id/key8"
            style="@style/KeyboardKeyStyle"
            android:text="8" />

        <TextView
            android:id="@+id/key9"
            style="@style/KeyboardKeyStyle"
            android:text="9" />

    </LinearLayout>

    <!-- 第四行 空 0 删除 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/key0"
            style="@style/KeyboardKeyStyle"
            android:text="0" />

        <FrameLayout
            android:id="@+id/keyDelete"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_keyboard_key"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_keyboard_delete" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>

