<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_transfer_detail"
    android:orientation="vertical">

    <include layout="@layout/wk_title_bar_layout" />

    <!-- 转账信息头部 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <!-- 转账图标 -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_transfer_detail_icon">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_transfer_white"
                app:tint="@android:color/white" />

        </FrameLayout>

        <!-- 金额 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/amountTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥0.00"
                android:textColor="@android:color/white"
                android:textSize="48sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 备注 -->
        <TextView
            android:id="@+id/remarkTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="转账"
            android:textColor="#E3F2FD"
            android:textSize="16sp" />

        <!-- 状态 -->
        <TextView
            android:id="@+id/statusTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_transfer_status_tag"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="待领取"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <!-- 时间 -->
        <TextView
            android:id="@+id/timeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#90CAF9"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 操作按钮区域 -->
    <LinearLayout
        android:id="@+id/actionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_transfer_action_container"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/receiveBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_transfer_receive_btn"
            android:gravity="center"
            android:text="领取"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/refundBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_transfer_refund_btn"
            android:gravity="center"
            android:text="退回"
            android:textColor="#1976D2"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 填充剩余空间 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white" />

</LinearLayout>

